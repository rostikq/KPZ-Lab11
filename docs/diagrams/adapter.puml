@startuml
skinparam classAttributeIconSize 0

interface SystemScale {
    + getWeightInKg(): double
    + getLengthInCm(): double
}

class StandardSystemScale {
    - kg: double
    - cm: double
    + StandardSystemScale(kg: double, cm: double)
    + getWeightInKg(): double
    + getLengthInCm(): double
}

class NewPartnerScaleDevice {
    + readWeightInPounds(): double
    + readLengthInInches(): double
}

class ScaleAdapter {
    - externalScale: NewPartnerScaleDevice
    + ScaleAdapter(externalScale: NewPartnerScaleDevice)
    + getWeightInKg(): double
    + getLengthInCm(): double
}

SystemScale <|.. StandardSystemScale
SystemScale <|.. ScaleAdapter
ScaleAdapter --> NewPartnerScaleDevice : адаптує

note top of ScaleAdapter : Патерн: Adapter\n(Узгодження несумісних інтерфейсів та одиниць)
@enduml